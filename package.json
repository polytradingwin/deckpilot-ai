{
  "name": "deckpilot-ai-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "doctor:openai": "tsx scripts/doctor-openai.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "quality:samples": "tsx scripts/quality-samples.ts",
    "audit:prepayment": "tsx scripts/prepayment-audit.ts",
    "setup:email-routing": "tsx scripts/setup-cloudflare-email-routing.ts",
    "verify:worker": "tsx scripts/verify-long-worker.ts",
    "preview": "vite preview --host 127.0.0.1",
    "worker": "tsx server/worker.ts",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@netlify/functions": "^5.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.555.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serverless-http": "^4.0.0",
    "stripe": "^22.3.0",
    "typescript": "^5.9.3",
    "undici": "^8.3.0",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.1",
    "tsx": "^4.22.4"
  }
}
