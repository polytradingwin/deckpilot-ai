OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.2
# Optional comma-separated fallback list. The first successful model is used.
# OPENAI_MODEL_CANDIDATES=gpt-5.2,gpt-5.1,gpt-5-mini
# Optional gateway/proxy/base URL for OpenAI-compatible routing.
# OPENAI_BASE_URL=https://api.openai.com
# Optional local proxy for environments where Node.js cannot reach OpenAI directly.
# OPENAI_HTTPS_PROXY=http://127.0.0.1:10808
PORT=8787
FREE_CREDITS=75
CREDIT_COST_PER_SLIDE=5
# DATABASE_PATH=output/deckpilot.sqlite

# Use sqlite for local-only storage or supabase for cloud persistence.
DATA_STORE=sqlite
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
# SUPABASE_BACKEND_SECRET=your_server_only_rpc_secret
# SUPABASE_STORAGE_BUCKET=deckpilot-pptx

# Set this to 1 for local API/PPTX testing without spending OpenAI credits.
MOCK_OPENAI=0
